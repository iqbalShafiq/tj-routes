# Server Configuration
SERVER_HOST=localhost
SERVER_PORT=8080
ENVIRONMENT=development
ALLOWED_ORIGIN=*

# Server timeouts
SERVER_READ_TIMEOUT=30
SERVER_WRITE_TIMEOUT=30

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=tj_routes
DB_SSLMODE=disable

# Database connection pool
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5

# Database migrations (set to false in production, use migration tool)
DB_RUN_MIGRATIONS=true

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_HOURS=168

# OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/oauth/google/callback

# Logging Configuration
LOG_LEVEL=info
ERROR_LOG_FILE=

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10

# Cache Configuration
CACHE_ENABLED=true
CACHE_ROUTE_TTL=30
CACHE_STOP_TTL=60
CACHE_VEHICLE_TTL=15
CACHE_SYSTEM_USER_TTL=1440

# File Storage Configuration
FILE_STORAGE_TYPE=local
FILE_UPLOAD_PATH=./uploads
FILE_MAX_PHOTO_SIZE_MB=5
FILE_MAX_PDF_SIZE_MB=10

# Cloud Storage Configuration (optional, only if FILE_STORAGE_TYPE=cloud)
FILE_CLOUD_PROVIDER=
FILE_CLOUD_BUCKET=
FILE_CLOUD_REGION=
FILE_CLOUD_ACCESS_KEY=
FILE_CLOUD_SECRET_KEY=
